{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile document containing account, subscription, and AI quota details.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "isPro": { "type": "boolean" },
        "planName": { "type": "string" },
        "subscriptionStatus": { "type": "string", "enum": ["active", "expired", "none"] },
        "subscriptionActivatedAt": { "type": "string" },
        "subscriptionExpiry": { "type": "string" },
        "lastPaymentId": { "type": "string" },
        "dailyAiCount": { "type": "number" },
        "dailyAiDate": { "type": "string" },
        "monthlyAiCount": { "type": "number" },
        "monthlyAiMonth": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "name", "email"]
    },
    "Goal": {
      "title": "Goal",
      "description": "Financial savings goal document.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "goalAmount": { "type": "number" },
        "amountSaved": { "type": "number" },
        "targetDate": { "type": "string" },
        "createdAt": { "type": "string" },
        "paymentFrequency": { "type": "string", "enum": ["Weekly", "Monthly", "Yearly"] },
        "completed": { "type": "boolean" },
        "completedDate": { "type": "string" },
        "category": { "type": "string" },
        "transactions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "amount": { "type": "number" },
              "date": { "type": "string" },
              "note": { "type": "string" }
            }
          }
        }
      },
      "required": ["id", "title", "goalAmount", "amountSaved", "targetDate", "completed"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Payment receipt for subscription upgrade via Razorpay.",
      "type": "object",
      "properties": {
        "paymentId": { "type": "string" },
        "amount": { "type": "number" },
        "amountPaise": { "type": "number" },
        "currency": { "type": "string" },
        "planName": { "type": "string" },
        "status": { "type": "string" },
        "activatedAt": { "type": "string" },
        "expiresAt": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["paymentId", "amount", "status", "userId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile information."
    },
    "/users/{userId}/goals/{goalId}": {
      "schema": "Goal",
      "description": "Savings goals created by this user."
    },
    "/users/{userId}/payments/{paymentId}": {
      "schema": "Payment",
      "description": "Payment transaction history for this user."
    }
  }
}
