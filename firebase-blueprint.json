{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile document containing account, subscription, and AI quota details.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "isPro": { "type": "boolean" },
        "planName": { "type": "string" },
        "subscriptionStatus": { "type": "string", "enum": ["active", "expired", "none"] },
        "subscriptionActivatedAt": { "type": "string" },
        "subscriptionExpiry": { "type": "string" },
        "lastPaymentId": { "type": "string" },
        "dailyAiCount": { "type": "number" },
        "dailyAiDate": { "type": "string" },
        "timezone": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "name", "email"]
    },
    "Goal": {
      "title": "Goal",
      "description": "Financial savings goal document with deadline and status.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "goalAmount": { "type": "number" },
        "amountSaved": { "type": "number" },
        "targetDate": { "type": "string" },
        "createdAt": { "type": "string" },
        "paymentFrequency": { "type": "string", "enum": ["Weekly", "Monthly", "Yearly"] },
        "completed": { "type": "boolean" },
        "completedDate": { "type": "string" },
        "category": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "completed", "overdue"] },
        "transactions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "amount": { "type": "number" },
              "date": { "type": "string" },
              "note": { "type": "string" }
            }
          }
        }
      },
      "required": ["id", "title", "goalAmount", "amountSaved", "targetDate", "completed"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Chat message history for BrainVibe AI financial coach.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "assistant"] },
        "content": { "type": "string" },
        "timestamp": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "role", "content", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile information and daily AI usage."
    },
    "/users/{userId}/goals/{goalId}": {
      "schema": "Goal",
      "description": "Savings goals created by this user."
    },
    "/users/{userId}/chats/{chatId}": {
      "schema": "ChatMessage",
      "description": "AI conversation history for this user."
    }
  }
}
