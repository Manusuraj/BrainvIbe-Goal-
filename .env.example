# ── Razorpay ────────────────────────────────────────────────────────────
# Dashboard → Account & Settings → API Keys. Key ID and Secret MUST be a
# matching pair from the same account and mode (rzp_test_… or rzp_live_…).
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# Backend-only Secret (NEVER prefix with VITE_, kept strictly on server)
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
# Optional: public key for the client (the server's order response is used if absent)
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx

# ── Firebase (your own project) ─────────────────────────────────────────
# Firebase Console → Project settings → General → Your apps → Web app → SDK config.
# When VITE_FIREBASE_PROJECT_ID is set, these replace firebase-applet-config.json.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Leave empty to use the project's "(default)" Firestore database
VITE_FIREBASE_FIRESTORE_DATABASE_ID=
